{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "database",
  "projectType": "application",
  "sourceRoot": "infrastructure/database",
  "tags": ["scope:infrastructure", "type:database"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml up -d --wait --wait-timeout 120"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml down"
      }
    },
    "reset": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml down -v"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml ps"
      }
    },
    "logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml logs --follow --tail 100"
      }
    },
    "config": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml config"
      }
    }
  }
}
