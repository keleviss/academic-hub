{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "database",
  "projectType": "application",
  "sourceRoot": "infrastructure/database",
  "tags": ["scope:infrastructure", "type:database"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml up -d"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml down"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml ps"
      }
    },
    "config": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose -f infrastructure/database/docker-compose.yml config"
      }
    }
  }
}
