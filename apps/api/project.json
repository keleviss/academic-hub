{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "prisma generate --config prisma.config.ts && tsc -p apps/api/tsconfig.app.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api --ext .ts"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/api/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/api/vitest.config.ts"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "prisma generate --config prisma.config.ts"
      }
    },
    "prisma-validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma validate --config prisma.config.ts"
      }
    },
    "prisma-format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma format --config prisma.config.ts"
      }
    },
    "prisma-migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --config prisma.config.ts"
      }
    },
    "prisma-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db seed --config prisma.config.ts"
      }
    }
  }
}
