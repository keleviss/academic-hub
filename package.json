    "db:migrate": "nx run api:prisma-migrate-dev",
    "db:seed": "nx run api:prisma-seed",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx"
  },
  "private": true,
