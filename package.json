  "scripts": {
    "dev": "nx run database:start && nx run api:prisma-generate && nx run api:prisma-migrate-deploy && NX_NATIVE_COMMAND_RUNNER=false nx run-many --target=serve --projects=api,web --parallel=2 --outputStyle=stream",
