# Application
NODE_ENV=development
PORT=3000
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:4200
CORS_ORIGIN=http://localhost:4200
# Optional browser override. Leave blank locally so Vite proxies same-origin /api calls.
VITE_API_BASE_URL=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uniwa_thesis
POSTGRES_USER=uniwa
POSTGRES_PASSWORD=uniwa_dev_password
DATABASE_URL=postgresql://uniwa:uniwa_dev_password@localhost:5432/uniwa_thesis

# MinIO / S3-compatible storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=course-materials
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Auth placeholders for local development
SESSION_SECRET=local-development-session-secret-change-me
SESSION_COOKIE_NAME=uniwa_session
SESSION_COOKIE_MAX_AGE_SECONDS=604800
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
CSRF_SECRET=local-development-csrf-secret-change-me
CSRF_HEADER_NAME=x-csrf-token
