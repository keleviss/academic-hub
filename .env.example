# Application
NODE_ENV=development
WEB_PORT=4200
API_PORT=3000
API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:4200
PLAYWRIGHT_BASE_URL=http://127.0.0.1:4200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uniwa_thesis
POSTGRES_USER=uniwa
POSTGRES_PASSWORD=uniwa_dev_password
DATABASE_URL=postgresql://uniwa:uniwa_dev_password@localhost:5432/uniwa_thesis

# MinIO / S3-compatible storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=course-materials
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# Auth placeholders for local development
SESSION_SECRET=replace-with-local-session-secret
CSRF_SECRET=replace-with-local-csrf-secret
