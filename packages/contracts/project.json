{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "packages/contracts/src",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/contracts"],
      "options": {
        "command": "tsc -p packages/contracts/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/contracts --ext .ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/contracts/vitest.config.ts"
      }
    }
  }
}
